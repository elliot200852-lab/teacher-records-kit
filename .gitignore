# ════════════════════════════════════════════════════════════════
# 個資 / 機密 —— 這是 public repo，以下一律「絕不」上傳
# ════════════════════════════════════════════════════════════════
# config.yaml：你的設定（含 email / 專案 id）
config.yaml
# .env：SMTP App Password 等密鑰
.env
# data/：你真實的學生紀錄、名冊、家長通訊錄全放這裡
data/
# firestore.rules：由 firestore.rules.tmpl 換入你的真實 email 產生，不是範本
firestore.rules
# *-key.json / serviceAccount*.json：服務帳號金鑰
*-key.json
serviceAccount*.json
# site/js/firebase-config.js：你真實的 Firebase 設定（範本是 firebase-config.example.js）
site/js/firebase-config.js
# .parent-emails-handled.tsv：已寄/略過紀錄
.parent-emails-handled.tsv
# *.prev.md：回寫前的備份
*.prev.md

# ════════════════════════════════════════════════════════════════
# 一般
# ════════════════════════════════════════════════════════════════
.DS_Store
node_modules/
__pycache__/
*.pyc
output/
