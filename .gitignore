# 你的設定（含 email / 專案 id）
config.yaml
# SMTP App Password 等密鑰
.env
# 你真實的學生紀錄、名冊、家長通訊錄全放這裡
data/
# 服務帳號金鑰
*-key.json
serviceAccount*.json
# 你真實的 Firebase 設定（範本是 firebase-config.example.js）
site/js/firebase-config.js
# 你的規則產生檔（{{OWNER_EMAIL}} 已換成真實 email）；正本是 firestore.rules.tmpl
firestore.rules
# 已寄/略過紀錄
.parent-emails-handled.tsv
# 回寫前的備份
*.prev.md

