rules_version = '2';

// Teacher Records Kit — Firestore 安全規則範本
// 安裝時把 {{OWNER_EMAIL}} 換成擁有者的 Google email，存成 firestore.rules 後部署：
//   firebase deploy --only firestore:rules --project <YOUR_PROJECT>
//
// 核心保證：只有擁有者本人（Google 登入 + 已驗證）能讀寫；其餘所有人一律 deny。

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == '{{OWNER_EMAIL}}'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // ── 紀錄 id 的形狀（2026-07-31 起）──
    // 一天可以記很多則：當天第一則 id ＝ 日期本身，之後每一則 ＝ 日期-建立時間
    // （`2026-09-10-1435`，同分鐘再撞就補到秒 `-143512`）。
    // 重點是「哪天記的」仍然釘死在 id 上：id 一旦建立就改不了，date 欄位也不准改
    //（見下方 update 條件），所以一則紀錄的日期歸屬事後無法竄改。
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validRid(rid, d) {
      return validDate(d) && (rid == d || rid.matches('^' + d + '-([0-9]{4}|[0-9]{6})$'));
    }

    // 每生摘要
    //
    // ── 學生卡上的兩張卡（v3 §3.6，三個垂直方案）──
    // IEP  → goals: [{id, 領域, 學年目標, 學期目標, 評量方式, 評量標準, 期程}]
    // SOAP → conceptualization: {主訴, 背景, 評估假設, 處遇目標, 結案標準}
    // 兩個鍵都由網頁上的「目標清單」／「個案概念化」卡直接寫進這份文件。
    // 下面這一行 write 已經涵蓋（owner 可寫整份卡），**故意不收窄成欄位白名單**：
    // 卡上的欄位跟業務組的 fields 一樣是「表單建議、不是 schema 閘」（§2.2、紅隊 #13），
    // 加一個欄位就要改規則、重新部署的話，老師會在網頁上看到莫名其妙的 permission-denied。
    match /students/{id} {
      allow read, write: if isOwner();

      // 每則觀察一份文件；文件 id ＝ 日期，或日期-建立時間（見 validRid）
      //
      // ── 記錄類型 stream（v3 加）──
      // 學生記錄再分類型（導師班級紀錄／任課老師紀錄／個案／IEP／會談紀錄（SOAP）…），
      // 每一則一定要說自己是哪一種：沒有 stream 的紀錄會在網頁上無家可歸，
      // 本機檔也不知道要寫進 students/<id>/<streamId>.md 的哪一個檔。
      // 建立時必填、之後不准改——改了等於把一則紀錄從一種類型搬到另一種，
      // 兩邊的本機檔會同時分岔。要換類型請刪掉重寫。
      // （get(k, 預設值) 讓 v2 留下來、還沒補上 stream 的舊紀錄仍然可以編輯。）
      match /records/{recordId} {
        allow read:   if isOwner();
        allow create: if isOwner() && validRid(recordId, request.resource.data.date)
                      && request.resource.data.stream is string
                      && request.resource.data.stream.size() > 0;
        allow update: if isOwner() && request.resource.data.date == resource.data.date
                      && request.resource.data.get('stream', '') == resource.data.get('stream', '');
        // v3：擁有者可以刪除。未成年人的紀錄必須能應家長要求刪除；
        // 網頁端有二次確認，sync.py 會把刪除傳播到本機檔並記進 data/audit.jsonl。
        allow delete: if isOwner();
      }
    }

    // 全班觀察（非針對單一學生的整班層次觀察；文件 id 規則同上）
    match /class-observations/{recordId} {
      allow read:   if isOwner();
      allow create: if isOwner() && validRid(recordId, request.resource.data.date);
      allow update: if isOwner() && request.resource.data.date == resource.data.date;
      // v3：擁有者可以刪除（理由同上）
      allow delete: if isOwner();
    }

    // 課程（主課程／科任）── 2026-07-31 加。
    // 課程卡本身 owner 可讀可寫：單租戶下 owner 就是唯一寫入者，沒有「防竄改計數」
    // 這個問題（計數也不存在文件上，儀表板是開頁即時算的）。這讓老師純用網頁就能建課程，
    // 不必為了建一門課去裝 gcloud——這是本 kit 的前提。
    match /courses/{courseId} {
      allow read, write: if isOwner();

      // 單則課程紀錄：規則與 students/{id}/records 完全同款
      match /records/{recordId} {
        allow read:   if isOwner();
        allow create: if isOwner() && validRid(recordId, request.resource.data.date);
        allow update: if isOwner() && request.resource.data.date == resource.data.date;
        // v3：擁有者可以刪除。未成年人的紀錄必須能應家長要求刪除；
        // 網頁端有二次確認，sync.py 會把刪除傳播到本機檔並記進 data/audit.jsonl。
        allow delete: if isOwner();
      }
    }

    // 業務記錄（v3 加）── business/{groupId} 是一組業務的卡片
    // （組名、欄位建議、常用標籤）；記錄放在它底下的 records。
    // 組的 fields 只是表單建議、不是 schema 閘：欄位名改了不需要 migration，
    // 所以規則不驗 fields 的內容。
    match /business/{groupId} {
      allow read, write: if isOwner();

      // 單則業務記錄：規則與 students/{id}/records 完全同款
      match /records/{recordId} {
        allow read:   if isOwner();
        allow create: if isOwner() && validRid(recordId, request.resource.data.date);
        allow update: if isOwner() && request.resource.data.date == resource.data.date;
        // v3：擁有者可以刪除（理由同上）
        allow delete: if isOwner();
      }
    }

    // 狀態與設定鏡像（v3 加）── meta/status 由 sync.py／backup.py 寫，
    // 網頁頂端讀它顯示「上次同步／上次備份幾天前」；超過七天顯示紅字，
    // 讓排程靜默死掉這件事看得見。meta/config 是 config/tabs.json 的唯讀鏡像。
    match /meta/{doc} {
      allow read, write: if isOwner();
    }

    // 代號↔姓名對照（供儀表板顯示真名；僅擁有者）
    match /roster/{doc} {
      allow read, write: if isOwner();
    }

    // ── 無頭交辦（選用；docs/HEADLESS.md）──
    // headless_events/{webhookEventId}：LINE relay 收到的每一則訊息一份文件
    //（文件 id ＝ LINE 的 webhookEventId，天然去重：同一則重送不會變成兩筆）。
    // headless_pairing/{userId}：還沒配對時 relay 記下「誰傳過訊息」，
    // 讓 `headless.py --pair` 在電腦上看得到那個 userId。
    //
    // relay 走 Admin SDK，**不受這些規則管**（伺服器端憑證一律繞過規則）——
    // 所以這兩條只管「人」：只有擁有者本人讀得到、刪得掉自己的交辦紀錄。
    // 網頁與手機瀏覽器如果被別人打開，看不到任何一則語音交辦的內容。
    match /headless_events/{eventId} {
      allow read, write: if isOwner();
    }
    match /headless_pairing/{userId} {
      allow read, write: if isOwner();
    }

    // 預設：其餘全部禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
