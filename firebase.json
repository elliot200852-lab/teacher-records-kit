{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.example.js"
    ],
    "rewrites": [
      { "source": "/", "destination": "/dashboard.html" }
    ]
  }
}
